COMPOSE_PROJECT_NAME=prccd-staging
APP_ENV=staging

# Base de datos
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=prccd_staging
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=prccd_staging

# Puertos publicados en la computadora o servidor
MYSQL_HOST_PORT=3307
EVALUACIONES_HOST_PORT=4101
INTEGRACION_HOST_PORT=4102
CERTIFICACION_HOST_PORT=4103
ANTIFRAUDE_HOST_PORT=4104
SEGURIDAD_HOST_PORT=4105
NOTIFICACIONES_HOST_PORT=4106
FRONTEND_HOST_PORT=5174

# URLs de Staging
FRONTEND_URL=http://localhost:5174
VITE_EVALUACIONES_API_URL=http://localhost:4101
VITE_INTEGRACION_API_URL=http://localhost:4102
VITE_CERTIFICACION_API_URL=http://localhost:4103
VITE_ANTIFRAUDE_API_URL=http://localhost:4104
VITE_SEGURIDAD_API_URL=http://localhost:4105
VITE_NOTIFICACIONES_API_URL=http://localhost:4106

# Valores de prueba del proyecto estudiantil
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_IV=0123456789abcdef0123456789abcdef

# Rutas de certificación
CERT_KEYS_HOST_PATH=./backend/certificacion-auditoria/keys
PRIVATE_KEY_PATH=/run/secrets/certificacion/private.pem
PUBLIC_KEY_PATH=/run/secrets/certificacion/public.pem

# Archivos específicos del ambiente
STT_ENV_FILE=./environments/staging/stt.env
SMTP_ENV_FILE=./environments/staging/smtp.env.example

# Integración entre certificación y notificaciones
NOTIFICACIONES_API_URL=http://servicio-notificaciones:4006
NOTIFICACIONES_TIMEOUT_MS=10000
CERTIFICACION_PUBLIC_URL=http://localhost:4103
