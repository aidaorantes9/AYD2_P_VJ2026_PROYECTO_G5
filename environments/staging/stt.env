STT_PROVIDER=whisper_local
STT_MODEL=base
STT_PROMPT="Transcribe una respuesta breve de un examen de competencias digitales."
MAX_AUDIO_MB=15

WHISPER_CPP_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-base.bin
WHISPER_CPP_THREADS=2

# DATO DELICADO: no colocar aquí una API key real.
OPENAI_API_KEY=
