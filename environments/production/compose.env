COMPOSE_PROJECT_NAME=prccd-production
APP_ENV=production

# Base de datos
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=prccd
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=prccd

# Puertos publicados en la computadora o servidor
MYSQL_HOST_PORT=3306
EVALUACIONES_HOST_PORT=4001
INTEGRACION_HOST_PORT=4002
CERTIFICACION_HOST_PORT=4003
ANTIFRAUDE_HOST_PORT=4004
SEGURIDAD_HOST_PORT=4005
NOTIFICACIONES_HOST_PORT=4006
FRONTEND_HOST_PORT=5173

# URLs de Producción
FRONTEND_URL=http://136.114.93.149:5173
VITE_EVALUACIONES_API_URL=http://136.114.93.149:4001
VITE_INTEGRACION_API_URL=http://136.114.93.149:4002
VITE_CERTIFICACION_API_URL=http://136.114.93.149:4003
VITE_ANTIFRAUDE_API_URL=http://136.114.93.149:4004
VITE_SEGURIDAD_API_URL=http://136.114.93.149:4005
VITE_NOTIFICACIONES_API_URL=http://136.114.93.149:4006

# Valores de prueba del proyecto estudiantil
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_IV=0123456789abcdef0123456789abcdef

# Rutas de certificación
CERT_KEYS_HOST_PATH=./backend/certificacion-auditoria/keys
PRIVATE_KEY_PATH=/run/secrets/certificacion/private.pem
PUBLIC_KEY_PATH=/run/secrets/certificacion/public.pem

# Archivos específicos del ambiente
STT_ENV_FILE=./environments/production/stt.env
SMTP_ENV_FILE=./environments/production/smtp.env.example

# Integración entre certificación y notificaciones
NOTIFICACIONES_API_URL=http://servicio-notificaciones:4006
NOTIFICACIONES_TIMEOUT_MS=10000
CERTIFICACION_PUBLIC_URL=http://136.114.93.149:4003

# Destinatarios de alertas antifraude
AUDITORES_ALERTA=auditor.prccd@example.com
